{
  "name": "mexplica",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma acadêmica de inclusão digital MExplica",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:check": "node scripts/checkDatabase.js",
    "db:schema": "node scripts/applyDatabaseSchema.js",
    "db:migrate": "node scripts/runMigrations.js",
    "db:seed": "node scripts/seedDatabase.js",
    "db:verify": "node scripts/verifyDatabase.js",
    "test": "node --require ./scripts/testSetup.js --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
