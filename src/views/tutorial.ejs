<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        MEXPLICA - <%= tutorial.titulo %>
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="shortcut icon"
        href="/icons/favicon.ico"
        type="image/x-icon"
    >

</head>


<body>


<script>

    (function() {

        var salvo =
            localStorage.getItem(
                'mexplica-tema'
            );


        if (
            salvo === '1'
        ) {

            document.body
                .classList
                .add(
                    'dark-blue'
                );

        }

    })();

</script>


<header class="header">

    <nav class="nav container">

        <a
            href="/"
            class="nav-logo"
        >

            <img
                src="/icons/logo-mexplica.png"
                alt="MEXPLICA"
                class="logo-icon"
            >

        </a>


        <ul class="nav-links">

            <li>
                <a href="/cadastro.html">
                    Colabore
                </a>
            </li>

            <li>
                <a href="/comunidade">
                    Comunidade
                </a>
            </li>

            <li>
                <a href="#">
                    Ajuda
                </a>
            </li>

            <li>
                <a href="#">
                    Sobre
                </a>
            </li>

        </ul>


        <div class="nav-actions">

            <% if (usuarioAtual) { %>

                <a
                    href="/perfil/<%= usuarioAtual.slug %>"
                    class="btn-acessar"
                >
                    <%= usuarioAtual.nome %>
                </a>

            <% } else { %>

                <a
                    href="/cadastro.html"
                    class="btn-acessar"
                >
                    acessar conta
                </a>

            <% } %>

        </div>


        <button
            class="nav-toggle"
            aria-label="Abrir menu"
            id="navToggle"
        >

            <span></span>
            <span></span>
            <span></span>

        </button>

    </nav>

</header>


<main class="mexp-page tutorial-workspace">
    <article class="container tutorial-publication mexp-theme-<%= tutorial.categoria.classe %>" data-tutorial-id="<%= tutorial.id %>">
        <header class="tutorial-publication-header">
            <div class="tutorial-author">
                <a class="mexp-avatar tutorial-author-avatar" href="/perfil/<%= tutorial.autor.slug %>" aria-label="Ver perfil de <%= tutorial.autor.nomeCompleto %>"><%= tutorial.autor.iniciais %></a>
                <div class="tutorial-author-info">
                    <a class="tutorial-author-name" href="/perfil/<%= tutorial.autor.slug %>"><%= tutorial.autor.nomeCompleto %></a>
                    <span class="tutorial-author-level"><img src="/icons/<%= tutorial.autor.nivel.toLowerCase() %>.png" alt="" aria-hidden="true">Colaborador <%= tutorial.autor.nivel %></span>
                </div>
                <a class="mexp-primary-button tutorial-author-profile" href="/perfil/<%= tutorial.autor.slug %>">Ver perfil</a>
            </div>
            <div class="mexp-tutorial-category"><img src="<%= tutorial.categoria.icone %>" alt="" aria-hidden="true"><span><%= tutorial.categoria.nome %></span></div>
            <h1><%= tutorial.titulo %></h1>
            <p class="tutorial-publication-summary"><%= tutorial.resumo %></p>
            <% const podeAvaliar = usuarioAtual && usuarioAtual.id !== tutorial.autorId; %>
            <div class="tutorial-metrics">
                <div <%- podeAvaliar ? 'id="tutorialRating"' : '' %> class="tutorial-header-rating" data-tutorial-id="<%= tutorial.id %>" data-avaliacao-id="<%= tutorial.minhaAvaliacao ? tutorial.minhaAvaliacao.id : '' %>">
                    <div class="mexp-stars" role="group" aria-label="<%= podeAvaliar ? 'Avaliar tutorial de 1 a 5 estrelas' : 'Média: ' + tutorial.avaliacao.media + ' de 5 estrelas' %>">
                        <% for (let nota = 1; nota <= 5; nota++) { %>
                            <% if (podeAvaliar) { %>
                                <button type="button" class="mexp-star <%= nota <= (tutorial.minhaAvaliacao ? tutorial.minhaAvaliacao.nota : tutorial.avaliacao.media) ? 'is-active' : '' %>" data-nota="<%= nota %>" aria-pressed="<%= !!tutorial.minhaAvaliacao && tutorial.minhaAvaliacao.nota === nota %>" aria-label="Avaliar com <%= nota %> estrela<%= nota === 1 ? '' : 's' %>">★</button>
                            <% } else { %>
                                <span class="mexp-star <%= nota <= Math.round(tutorial.avaliacao.media) ? 'is-active' : '' %>" aria-hidden="true">★</span>
                            <% } %>
                        <% } %>
                    </div>
                    <% if (tutorial.minhaAvaliacao && podeAvaliar) { %><button type="button" id="removerAvaliacao" class="mexp-text-button">Remover minha avaliação</button><% } %>
                </div>
                <span><strong><%= tutorial.avaliacao.media %></strong> de 5 · <%= tutorial.avaliacao.quantidade %> avaliações</span>
                <span><strong><%= tutorial.visualizacoes %></strong> visualizações</span>
                <a href="#comentarios"><strong><%= tutorial.quantidadeComentarios %></strong> comentários</a>
            </div>
            <p id="avaliacaoMensagem" class="tutorial-help" role="status"><% if (!usuarioAtual) { %><a class="tutorial-external-link" href="/cadastro.html?redirect=<%= encodeURIComponent('/tutoriais/' + tutorial.slug) %>">Entre na sua conta para avaliar.</a><% } else if (!podeAvaliar) { %>O autor não pode avaliar o próprio tutorial.<% } else { %><%= tutorial.minhaAvaliacao ? 'Sua avaliação: ' + tutorial.minhaAvaliacao.nota + ' estrelas. Clique para atualizar.' : 'Este tutorial ajudou? Escolha uma estrela para avaliar.' %><% } %></p>
            <% if (usuarioAtual && usuarioAtual.id === tutorial.autorId) { %>
                <div class="mexp-inline-actions tutorial-owner-actions">
                    <a href="/tutoriais/<%= tutorial.slug %>/editar" class="mexp-secondary-button">Editar post</a>
                    <button type="button" id="excluirTutorial" class="mexp-danger-button" data-id="<%= tutorial.id %>">Excluir post</button>
                </div>
            <% } %>
        </header>
        <p class="tutorial-introduction"><%= tutorial.conteudo %></p>
        <section aria-label="Passo a passo">
            <div class="tutorial-view-controls">
                <details id="modoVisualizacao" class="tutorial-view-dropdown">
                    <summary>▦ <span id="modoVisualizacaoTexto">Visualização por quadros</span><span aria-hidden="true">⌄</span></summary>
                    <div class="tutorial-view-options" role="group" aria-label="Visualização dos passos">
                        <button type="button" data-modo="quadros" aria-pressed="true">✓ Visualização por quadros</button>
                        <button type="button" data-modo="simples" aria-pressed="false">Visualização simples</button>
                    </div>
                </details>
            </div>
            <div id="passosPublicados" class="tutorial-published-steps" data-modo="quadros" data-quantidade="<%= tutorial.passos.length %>">
                <% tutorial.passos.forEach(passo => { %>
                    <section class="tutorial-published-step">
                        <span class="tutorial-published-number">Passo <%= passo.ordem %></span>
                        <% if (passo.imagem) { %>
                            <figure><img class="tutorial-published-image" src="<%= passo.imagem.url %>" alt="<%= passo.imagem.alt %>" loading="lazy"><% if (passo.imagem.legenda) { %><figcaption><%= passo.imagem.legenda %></figcaption><% } %></figure>
                        <% } %>
                        <h2><%= passo.titulo %></h2>
                        <p><%= passo.descricao %></p>
                        <% if (passo.linkExterno) { %><a class="tutorial-external-link" href="<%= passo.linkExterno.url %>" target="_blank" rel="noopener noreferrer"><%= passo.linkExterno.texto %> ↗</a><% } %>
                    </section>
                <% }) %>
            </div>
        </section>
        <% if (tutorial.videoId) { %>
            <section class="tutorial-video" aria-labelledby="videoTitulo">
                <button type="button" class="tutorial-video-preview" data-youtube-id="<%= tutorial.videoId %>" aria-label="Reproduzir vídeo do tutorial">
                    <img src="https://i.ytimg.com/vi/<%= tutorial.videoId %>/hqdefault.jpg" alt="" loading="lazy" referrerpolicy="no-referrer">
                    <span class="tutorial-video-play" aria-hidden="true">▶</span>
                </button>
                <h2 id="videoTitulo">Assista ao tutorial de vídeo</h2>
                <a class="tutorial-external-link" href="<%= tutorial.videoUrl %>" target="_blank" rel="noopener noreferrer">Abrir no YouTube ↗</a>
            </section>
        <% } else if (tutorial.videoUrl) { %>
            <section class="tutorial-video"><h2>Vídeo complementar</h2><a class="tutorial-external-link" href="<%= tutorial.videoUrl %>" target="_blank" rel="noopener noreferrer">Assistir ao vídeo tutorial ↗</a></section>
        <% } %>
        <% if (tutorial.tags.length) { %><div class="mexp-tag-row mexp-tutorial-tags"><% tutorial.tags.forEach(tag => { %><span class="mexp-tag">#<%= tag %></span><% }) %></div><% } %>
    </article>
<section id="comentarios" class="container mexp-section tutorial-comments">


        <div class="mexp-section-heading">


            <div>

                <span class="mexp-eyebrow">
                    COMENTÁRIOS
                </span>

                <h2>

                    <%= comentarios.length %>

                    comentário<%= comentarios.length === 1 ? '' : 's' %>

                </h2>

            </div>


            <p>

                Conte se o tutorial funcionou
                para você ou deixe um agradecimento
                ao colaborador.

            </p>


        </div>


        <% if (usuarioAtual) { %>


            <form
                id="formComentario"
                class="mexp-form"
                data-tutorial-id="<%= tutorial.id %>"
            >


                <label for="comentarioTexto">
                    Seu comentário
                </label>


                <textarea
                    id="comentarioTexto"
                    maxlength="1000"
                    required
                    placeholder="Ex.: Muito obrigado! Consegui resolver meu problema."
                ></textarea>


                <p
                    id="comentarioMensagem"
                    class="mexp-form-message"
                    aria-live="polite"
                ></p>


                <button
                    type="submit"
                    class="mexp-primary-button"
                >
                    Publicar comentário
                </button>


            </form>


        <% } else { %>


            <p class="mexp-login-hint">

                <a
                    href="/cadastro.html?redirect=<%= encodeURIComponent(`/tutoriais/${tutorial.slug}`) %>"
                >
                    Entre na sua conta
                </a>

                para comentar.

            </p>


        <% } %>


        <div class="mexp-comments-list">


            <% if (!comentarios.length) { %>


                <p class="mexp-empty">

                    Ainda não há comentários
                    neste tutorial.

                </p>


            <% } %>


            <%
                comentarios.forEach(
                    comentario => {
            %>


                <article
                    class="mexp-comment-card"
                    data-comentario-id="<%= comentario.id %>"
                >


                    <div class="mexp-answer-author">


                        <div class="mexp-avatar">

                            <%= comentario.autor.iniciais %>

                        </div>


                        <div>


                            <a
                                href="/perfil/<%= comentario.autor.slug %>"
                            >

                                <strong>

                                    <%= comentario.autor.nomeCompleto %>

                                </strong>

                            </a>


                            <span>

                                <%= comentario.autor.colaborador

                                    ? `Colaborador ${comentario.autor.nivel}`

                                    : 'Usuário'

                                %>

                            </span>


                        </div>


                    </div>


                    <p class="mexp-comment-text">

                        <%= comentario.texto %>

                    </p>


                    <%
                        if (
                            usuarioAtual
                            &&
                            usuarioAtual.id
                            === comentario.usuarioId
                        ) {
                    %>


                        <div class="mexp-inline-actions">


                            <button
                                type="button"
                                class="mexp-text-button editar-comentario"
                                data-id="<%= comentario.id %>"
                            >
                                Editar
                            </button>


                            <button
                                type="button"
                                class="mexp-text-button excluir-comentario"
                                data-id="<%= comentario.id %>"
                            >
                                Excluir
                            </button>


                        </div>


                    <% } %>


                </article>


            <% }) %>


        </div>


    </section>


</main>


<% if (usuarioAtual && usuarioAtual.id === tutorial.autorId) { %>
<dialog id="modalExcluirTutorial" class="tutorial-delete-dialog" aria-labelledby="excluirTitulo" aria-describedby="excluirDescricao">
    <h2 id="excluirTitulo">Excluir post?</h2>
    <p id="excluirDescricao">Tem certeza de que deseja excluir este post? Esta ação também removerá os comentários e avaliações relacionados.</p>
    <p id="excluirMensagem" class="tutorial-feedback" role="status"></p>
    <div class="tutorial-dialog-actions"><button type="button" id="confirmarExclusao" class="mexp-danger-button">Excluir post</button><button type="button" id="cancelarExclusao" class="mexp-secondary-button" autofocus>Cancelar</button></div>
</dialog>
<% } %>
<%- include('partials/footer') %>
<script src="/js/core/site.js"></script>
<script src="/js/core/api.js"></script>
<script src="/js/tutorial/view.js"></script>


</body>

</html>