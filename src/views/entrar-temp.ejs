<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        MExplica - Teste de autenticação
    </title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

    <style>

        .temp-page {
            max-width: 680px;
            margin: 48px auto;
            padding: 24px;
            font-family: Arial, sans-serif;
        }

        .temp-card {
            border: 1px solid #ddd;
            border-radius: 16px;
            padding: 24px;
            background: #fff;
        }

        .temp-card input,
        .temp-card select,
        .temp-card textarea {
            width: 100%;
            padding: 12px;
            margin: 6px 0 12px;
            box-sizing: border-box;
        }

        .temp-card button {
            padding: 12px 18px;
            cursor: pointer;
            margin-right: 8px;
        }

        .temp-hidden {
            display: none;
        }

        .temp-msg {
            margin-top: 16px;
            min-height: 24px;
        }

    </style>

</head>


<body>

<main class="temp-page">

    <p>

        <a href="/">
            ← Voltar para a home
        </a>

    </p>


    <div class="temp-card">

        <h1>
            Teste temporário de login/cadastro
        </h1>


        <p>
            Esta tela existe apenas para testar
            o backend antes do layout definitivo.
        </p>


        <!-- IDENTIFICADOR -->

        <section id="etapa-identificador">

            <label for="identificador">
                Email ou telefone
            </label>

            <input
                id="identificador"
                type="text"
                placeholder="Ex.: lucas@mexplica.com"
            >

            <button
                id="verificar"
                type="button"
            >
                Continuar
            </button>

        </section>


        <!-- LOGIN -->

        <section
            id="etapa-login"
            class="temp-hidden"
        >

            <h2>
                Usuário encontrado
            </h2>

            <label for="senha-login">
                Senha
            </label>

            <input
                id="senha-login"
                type="password"
                placeholder="Senha"
            >

            <button
                id="entrar"
                type="button"
            >
                Entrar
            </button>

            <button
                class="voltar"
                type="button"
            >
                Voltar
            </button>

        </section>


        <!-- CADASTRO -->

        <section
            id="etapa-cadastro"
            class="temp-hidden"
        >

            <h2>
                Novo por aqui?
                Continue seu cadastro.
            </h2>


            <label for="nome">
                Nome
            </label>

            <input
                id="nome"
                type="text"
            >


            <label for="sobrenome">
                Sobrenome
            </label>

            <input
                id="sobrenome"
                type="text"
            >


            <label for="idade">
                Idade
            </label>

            <input
                id="idade"
                type="number"
                min="10"
                max="120"
            >


            <label for="genero">
                Gênero
            </label>

            <select id="genero">

                <option value="">
                    Selecione
                </option>

                <option value="masculino">
                    Masculino
                </option>

                <option value="feminino">
                    Feminino
                </option>

                <option value="nao-binario">
                    Não-binário
                </option>

                <option value="prefiro-nao-dizer">
                    Prefiro não dizer
                </option>

            </select>


            <label for="senha-cadastro">
                Senha
            </label>

            <input
                id="senha-cadastro"
                type="password"
                minlength="6"
            >


            <label>

                <input
                    id="colaborador"
                    type="checkbox"
                    style="width:auto;"
                >

                Quero ser colaborador

            </label>


            <br><br>


            <button
                id="cadastrar"
                type="button"
            >
                Criar conta
            </button>


            <button
                class="voltar"
                type="button"
            >
                Voltar
            </button>

        </section>


        <p
            id="mensagem"
            class="temp-msg"
            aria-live="polite"
        ></p>


        <hr>


        <p>
            <strong>
                Usuários de teste:
            </strong>
        </p>

        <p>
            lucas@mexplica.com / 123456
        </p>

        <p>
            maria@mexplica.com / 123456
        </p>

        <p>
            ana@mexplica.com / 123456
        </p>

    </div>

</main>


<script src="/auth-temp.js"></script>

</body>

</html>