<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        MEXPLICA - Comunidade
    </title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

    <link
        rel="shortcut icon"
        href="/icons/favicon.ico"
        type="image/x-icon"
    >

</head>


<body>

<script>

    (function() {

        var salvo =
            localStorage.getItem(
                'mexplica-tema'
            );

        if (
            salvo === '1'
        ) {

            document.body
                .classList
                .add(
                    'dark-blue'
                );

        }

    })();

</script>


<header class="header">

    <nav class="nav container">

        <a
            href="/"
            class="nav-logo"
        >

            <img
                src="/icons/logo-mexplica.png"
                alt="MEXPLICA"
                class="logo-icon"
            >

        </a>


        <ul class="nav-links">

            <li>
                <a href="/cadastro.html">
                    Colabore
                </a>
            </li>

            <li>
                <a href="/comunidade">
                    Comunidade
                </a>
            </li>

            <li>
                <a href="#">
                    Ajuda
                </a>
            </li>

            <li>
                <a href="#">
                    Sobre
                </a>
            </li>

        </ul>


        <div class="nav-actions">

            <% if (usuarioAtual) { %>

                <a
                    href="/perfil/<%= usuarioAtual.slug %>"
                    class="btn-acessar"
                >

                    <%= usuarioAtual.nome %>

                </a>

            <% } else { %>

                <a
                    href="/cadastro.html"
                    class="btn-acessar"
                >
                    acessar conta
                </a>

            <% } %>

        </div>


        <button
            class="nav-toggle"
            aria-label="Abrir menu"
            id="navToggle"
        >

            <span></span>
            <span></span>
            <span></span>

        </button>

    </nav>

</header>


<main class="mexp-page">

<section
    class="mexp-page-hero container"
>

    <div class="mexp-hero-logo">
        <img
            src="icons/logo-mexplica.png"
            alt=""
            aria-hidden="true"
            class="hero-logo-img"
        >
    </div>

    <h1>
        Quem ajuda a comunidade
        a aprender tecnologia
    </h1>

        <p>
            Conheça os colaboradores em destaque
            e veja quais dúvidas chamaram mais
            atenção nesta semana.
            Para encontrar a resposta para o seu
            problema, use a pesquisa da página inicial.
        </p>

        <a
            href="/"
            class="mexp-primary-link"
        >
            Pesquisar uma dúvida
        </a>

    </section>


    <section class="container mexp-section">

        <div class="mexp-section-heading">

            <div>

                <span class="mexp-eyebrow">
                    RANKING
                </span>

                <h2>
                    Colaboradores em destaque
                </h2>

            </div>

            <p>
                O ranking reúne colaboradores
                Diamante e Platina, ordenados
                pela pontuação acumulada.
            </p>

        </div>


        <div class="mexp-ranking-list">

            <%
                ranking.forEach(
                    (colaborador, index) => {
            %>


                <a
                    href="/perfil/<%= colaborador.slug %>"
                    class="mexp-ranking-card"
                >

                    <span class="mexp-ranking-position">

                        <%= index + 1 %>º

                    </span>


                    <div class="mexp-avatar">

                        <%= colaborador.nome.charAt(0) %>

                    </div>


                    <div class="mexp-ranking-info">

                        <strong>
                            <%= colaborador.nomeCompleto %>
                        </strong>

                        <span>

                            <%= colaborador.nivel %>
                            ·
                            <%= colaborador.pontos %>
                            pontos

                        </span>


                        <%
                            if (
                                colaborador.especialidades.length
                            ) {
                        %>

                            <small>

                                <%= colaborador.especialidades.join(' · ') %>

                            </small>

                        <% } %>

                    </div>


                    <%
                        if (
                            colaborador.nivel
                            === 'Platina'
                        ) {
                    %>

                        <span
                            class="mexp-badge mexp-badge-platinum"
                        >
                            PLATINA
                        </span>

                    <% } else { %>

                        <span class="mexp-badge">
                            DIAMANTE
                        </span>

                    <% } %>

                </a>


            <% }) %>

        </div>

    </section>


    <section class="container mexp-section">

        <div class="mexp-section-heading">

            <div>

                <span class="mexp-eyebrow">
                    EM ALTA
                </span>

                <h2>
                    Maiores dúvidas da semana
                </h2>

            </div>

            <p>
                Assuntos que mais receberam
                visualizações recentemente
                na plataforma.
            </p>

        </div>


        <div class="mexp-question-grid">

            <%
                maioresDuvidas.forEach(
                    duvida => {
            %>


                <a
                    href="/duvidas/<%= duvida.slug %>"
                    class="mexp-question-card"
                >

                    <span class="mexp-category">

                        <%= duvida.categoria %>

                    </span>

                    <h3>
                        <%= duvida.titulo %>
                    </h3>

                    <p>
                        <%= duvida.conteudo %>
                    </p>

                    <div class="mexp-question-meta">

                        <span>
                            <%= duvida.visualizacoes %>
                            visualizações
                        </span>

                        <span>
                            <%= duvida.quantidadeRespostas %>
                            respostas
                        </span>

                    </div>

                </a>


            <% }) %>

        </div>

    </section>

</main>


<script src="/script.js"></script>

</body>

</html>