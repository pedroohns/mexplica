<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        MEXPLICA - Comunidade
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="shortcut icon"
        href="/icons/favicon.ico"
        type="image/x-icon"
    >

</head>


<body>


<script>

    (function() {

        var salvo =
            localStorage.getItem(
                'mexplica-tema'
            );


        if (
            salvo === '1'
        ) {

            document.body
                .classList
                .add(
                    'dark-blue'
                );

        }

    })();

</script>


<header class="header">

    <nav class="nav container">

        <a
            href="/"
            class="nav-logo"
        >

            <img
                src="/icons/logo-mexplica.png"
                alt="MEXPLICA"
                class="logo-icon"
            >

        </a>


        <ul class="nav-links">

            <li>
                <a href="/cadastro.html">
                    Colabore
                </a>
            </li>

            <li>
                <a href="/comunidade">
                    Comunidade
                </a>
            </li>

            <li>
                <a href="#">
                    Ajuda
                </a>
            </li>

            <li>
                <a href="#">
                    Sobre
                </a>
            </li>

        </ul>


        <div class="nav-actions">

            <% if (usuarioAtual) { %>

                <a
                    href="/perfil/<%= usuarioAtual.slug %>"
                    class="btn-acessar"
                >
                    <%= usuarioAtual.nome %>
                </a>

            <% } else { %>

                <a
                    href="/cadastro.html"
                    class="btn-acessar"
                >
                    acessar conta
                </a>

            <% } %>

        </div>


        <button
            class="nav-toggle"
            aria-label="Abrir menu"
            id="navToggle"
        >

            <span></span>
            <span></span>
            <span></span>

        </button>

    </nav>

</header>


<main class="mexp-page community-page">
    <div class="community-highlight">
        <section class="container community-hero" aria-labelledby="community-title">
            <h1 id="community-title">Comunidade MExplica</h1>
            <p>Conheça nossos colaboradores em destaque e veja os tutoriais que mais ajudaram a comunidade neste mês.</p>
        </section>

        <div class="container community-rankings">
            <%- include('partials/community-ranking', {
                id: 'colaboradores',
                titulo: 'Ranking de Colaboradores',
                descricao: 'Estes são nossos colaboradores com maior pontuação neste mês.',
                participantes: ranking,
                respostas: false,
                vazio: 'Os colaboradores em destaque aparecerão aqui conforme conquistarem pontos.'
            }) %>
            <%- include('partials/community-ranking', {
                id: 'respostas',
                titulo: 'Ranking de Respostas',
                descricao: 'Estes são os colaboradores que mais publicaram tutoriais nesta semana.',
                participantes: rankingRespostas,
                respostas: true,
                vazio: 'Ainda não há tutoriais publicados nos últimos sete dias. A próxima contribuição pode ser sua!'
            }) %>
        </div>
    </div>

    <section class="container community-join" aria-labelledby="community-join-title">
        <h2 id="community-join-title">Conheça a comunidade MExplica</h2>
        <p>Aqui as pessoas se conectam com postagens e comentários. Faça parte da comunidade.</p>
        <a class="mexp-primary-link community-cta" href="<%= usuarioAtual ? '/tutoriais/novo' : '/cadastro.html' %>">
            <%= usuarioAtual ? '+ Fazer publicação' : 'Criar sua conta' %>
        </a>
    </section>

    <section class="container mexp-section">


        <div class="mexp-section-heading">


            <div>

                <span class="mexp-eyebrow">
                    EM ALTA
                </span>

                <h2>
                    Tutoriais mais acessados da semana
                </h2>

            </div>


            <p>

                Conteúdos publicados voluntariamente
                pelos colaboradores que receberam
                mais visualizações recentemente.

            </p>


        </div>


        <div class="mexp-question-grid">


            <%
                tutoriaisEmAlta.forEach(
                    tutorial => {
            %>


                <a
                    href="/tutoriais/<%= tutorial.slug %>"
                    class="mexp-question-card mexp-theme-<%= tutorial.categoria.classe %>"
                >


                    <div class="mexp-card-category-line">


                        <img
                            src="<%= tutorial.categoria.icone %>"
                            alt=""
                            aria-hidden="true"
                        >


                        <span class="mexp-category">

                            <%= tutorial.categoria.nome %>

                        </span>


                    </div>


                    <h3>
                        <%= tutorial.titulo %>
                    </h3>


                    <p>
                        <%= tutorial.resumo %>
                    </p>


                    <div class="mexp-question-meta">


                        <span>

                            <%= tutorial.visualizacoes %>
                            visualizações

                        </span>


                        <span>

                            <%= tutorial.avaliacao.quantidade

                                ? `${tutorial.avaliacao.media} ★`

                                : 'sem avaliações'

                            %>

                        </span>


                        <span>

                            <%= tutorial.quantidadeComentarios %>
                            comentários

                        </span>


                    </div>


                </a>


            <% }) %>


        </div>


    </section>


</main>

<footer class="footer">
        <div class="container footer-inner">
            <div class="footer-brand">
                <img src="/icons/logo-completa.png" alt="" class="footer-logo-icon" aria-hidden="true">
            </div>

            <div class="footer-columns">
                <div class="footer-col">
                    <h4>CONTATO</h4>
                    <ul>
                        <li><a href="#">SUPORTE</a></li>
                        <li><a href="#">POLÍTICA DE PRIVACIDADE</a></li>
                        <li><a href="#">TERMO DE USO</a></li>
                        <li><a href="#">BLOG</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>DÚVIDAS FREQUENTES</h4>
                    <ul>
                        <li><a href="#">CARREIRAS</a></li>
                        <li><a href="#">TERMOS DE SERVIÇO</a></li>
                        <li><a href="#">FEEDBACK</a></li>
                        <li><a href="#">REDE SOCIAL</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>ATENDIMENTO</h4>
                    <ul>
                        <li><a href="#">APOIO TÉCNICO</a></li>
                        <li><a href="#">SEGURANÇA</a></li>
                        <li><a href="#">EVENTOS</a></li>
                        <li><a href="#">NEWSLETTER</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-copy">
            <span>© MEXPLICA 2025. Todos os direitos reservados.</span>
        </div>
    </footer>


<script src="/js/core/site.js"></script>


</body>

</html>
