<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        MEXPLICA - Comunidade
    </title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

    <link
        rel="shortcut icon"
        href="/icons/favicon.ico"
        type="image/x-icon"
    >

</head>


<body>


<script>

    (function() {

        var salvo =
            localStorage.getItem(
                'mexplica-tema'
            );


        if (
            salvo === '1'
        ) {

            document.body
                .classList
                .add(
                    'dark-blue'
                );

        }

    })();

</script>


<header class="header">

    <nav class="nav container">

        <a
            href="/"
            class="nav-logo"
        >

            <img
                src="/icons/logo-mexplica.png"
                alt="MEXPLICA"
                class="logo-icon"
            >

        </a>


        <ul class="nav-links">

            <li>
                <a href="/cadastro.html">
                    Colabore
                </a>
            </li>

            <li>
                <a href="/comunidade">
                    Comunidade
                </a>
            </li>

            <li>
                <a href="#">
                    Ajuda
                </a>
            </li>

            <li>
                <a href="#">
                    Sobre
                </a>
            </li>

        </ul>


        <div class="nav-actions">

            <% if (usuarioAtual) { %>

                <a
                    href="/perfil/<%= usuarioAtual.slug %>"
                    class="btn-acessar"
                >
                    <%= usuarioAtual.nome %>
                </a>

            <% } else { %>

                <a
                    href="/cadastro.html"
                    class="btn-acessar"
                >
                    acessar conta
                </a>

            <% } %>

        </div>


        <button
            class="nav-toggle"
            aria-label="Abrir menu"
            id="navToggle"
        >

            <span></span>
            <span></span>
            <span></span>

        </button>

    </nav>

</header>


<main class="mexp-page">


    <section class="mexp-page-hero container">


        <div class="mexp-hero-logo">

            <img
                src="/icons/logo-mexplica.png"
                alt=""
                aria-hidden="true"
                class="hero-logo-img"
            >

        </div>


        <h1>

            Quem ajuda a comunidade
            a aprender tecnologia

        </h1>


        <p>

            Conheça os colaboradores em destaque
            e veja os tutoriais que mais ajudaram
            a comunidade nesta semana.
            Para resolver uma dúvida,
            use a pesquisa da página inicial.

        </p>


        <a
            href="/"
            class="mexp-primary-link"
        >
            Pesquisar uma dúvida
        </a>


    </section>


    <section class="container mexp-section">


        <div class="mexp-section-heading">


            <div>

                <span class="mexp-eyebrow">
                    RANKING
                </span>

                <h2>
                    Colaboradores em destaque
                </h2>

            </div>


            <p>

                O ranking reúne colaboradores
                Diamante e Platina, ordenados pela
                pontuação conquistada com as avaliações
                dos tutoriais publicados.

            </p>


        </div>


        <div class="mexp-ranking-list">


            <%
                ranking.forEach(
                    (
                        colaborador,
                        index
                    ) => {
            %>


                <a
                    href="/perfil/<%= colaborador.slug %>"
                    class="mexp-ranking-card"
                >


                    <span class="mexp-ranking-position">

                        <%= index + 1 %>º

                    </span>


                    <div class="mexp-avatar">

                        <%= colaborador.nome.charAt(0) %>

                    </div>


                    <div class="mexp-ranking-info">

                        <strong>
                            <%= colaborador.nomeCompleto %>
                        </strong>

                        <span>

                            <%= colaborador.nivel %>
                            ·
                            <%= colaborador.pontos %>
                            pontos

                        </span>


                        <% if (colaborador.especialidades.length) { %>

                            <small>

                                <%= colaborador.especialidades.join(' · ') %>

                            </small>

                        <% } %>

                    </div>


                    <span
                        class="mexp-badge <%= colaborador.nivel === 'Platina' ? 'mexp-badge-platinum' : '' %>"
                    >

                        <%= colaborador.nivel.toUpperCase() %>

                    </span>


                </a>


            <% }) %>


        </div>


    </section>


    <section class="container mexp-section">


        <div class="mexp-section-heading">


            <div>

                <span class="mexp-eyebrow">
                    EM ALTA
                </span>

                <h2>
                    Tutoriais mais acessados da semana
                </h2>

            </div>


            <p>

                Conteúdos publicados voluntariamente
                pelos colaboradores que receberam
                mais visualizações recentemente.

            </p>


        </div>


        <div class="mexp-question-grid">


            <%
                tutoriaisEmAlta.forEach(
                    tutorial => {
            %>


                <a
                    href="/tutoriais/<%= tutorial.slug %>"
                    class="mexp-question-card mexp-theme-<%= tutorial.categoria.classe %>"
                >


                    <div class="mexp-card-category-line">


                        <img
                            src="<%= tutorial.categoria.icone %>"
                            alt=""
                            aria-hidden="true"
                        >


                        <span class="mexp-category">

                            <%= tutorial.categoria.nome %>

                        </span>


                    </div>


                    <h3>
                        <%= tutorial.titulo %>
                    </h3>


                    <p>
                        <%= tutorial.resumo %>
                    </p>


                    <div class="mexp-question-meta">


                        <span>

                            <%= tutorial.visualizacoes %>
                            visualizações

                        </span>


                        <span>

                            <%= tutorial.avaliacao.quantidade

                                ? `${tutorial.avaliacao.media} ★`

                                : 'sem avaliações'

                            %>

                        </span>


                        <span>

                            <%= tutorial.quantidadeComentarios %>
                            comentários

                        </span>


                    </div>


                </a>


            <% }) %>


        </div>


    </section>


</main>


<script src="/script.js"></script>


</body>

</html>