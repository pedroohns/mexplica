<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        MExplica - Comunidade
    </title>

    <link
        rel="stylesheet"
        href="/style.css"
    >


    <style>

        .temp-page {
            max-width: 900px;
            margin: 40px auto;
            padding: 24px;
            font-family: Arial, sans-serif;
        }

        .temp-topo {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            align-items: center;
            flex-wrap: wrap;
        }

        .temp-card {
            border: 1px solid #ddd;
            border-radius: 16px;
            padding: 20px;
            margin: 18px 0;
            background: #fff;
        }

        .temp-card textarea,
        .temp-card input,
        .temp-card select {
            width: 100%;
            padding: 10px;
            margin: 6px 0 10px;
            box-sizing: border-box;
        }

        .temp-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .temp-actions button,
        .temp-card button {
            padding: 9px 14px;
            cursor: pointer;
        }

        .temp-comment {
            margin: 12px 0 0 24px;
            padding: 12px;
            border-left: 3px solid #ddd;
        }

    </style>

</head>


<body>

<main class="temp-page">


    <div class="temp-topo">


        <div>

            <p>
                <a href="/">
                    ← Home
                </a>
            </p>

            <h1>
                Comunidade — versão temporária
            </h1>

        </div>


        <div>

            <% if (usuarioAtual) { %>

                <span>
                    Olá,
                    <strong>
                        <%= usuarioAtual.nome %>
                    </strong>
                </span>


                <a
                    href="/perfil/<%= usuarioAtual.slug %>"
                >
                    Meu perfil
                </a>


                <button
                    id="logout"
                    type="button"
                >
                    Sair
                </button>


            <% } else { %>


                <a href="/entrar">
                    Entrar
                </a>


            <% } %>

        </div>

    </div>


    <% if (usuarioAtual) { %>


        <section class="temp-card">

            <h2>
                Criar publicação
            </h2>


            <form id="form-novo-post">


                <label for="titulo">
                    Título
                </label>

                <input
                    id="titulo"
                    name="titulo"
                    maxlength="160"
                    required
                >


                <label for="conteudo">
                    Conteúdo
                </label>

                <textarea
                    id="conteudo"
                    name="conteudo"
                    maxlength="2000"
                    required
                ></textarea>


                <label for="categoria">
                    Categoria
                </label>

                <select
                    id="categoria"
                    name="categoria"
                >

                    <option>
                        Geral
                    </option>

                    <option>
                        Segurança
                    </option>

                    <option>
                        Comunicação
                    </option>

                    <option>
                        Acessibilidade
                    </option>

                    <option>
                        Sistemas
                    </option>

                </select>


                <button type="submit">
                    Publicar
                </button>


            </form>

        </section>


    <% } else { %>


        <section class="temp-card">

            <p>
                Entre na sua conta
                para publicar ou comentar.
            </p>

            <a href="/entrar">
                Acessar conta
            </a>

        </section>


    <% } %>


    <section>


        <% posts.forEach((post) => { %>


            <article
                class="temp-card"
                data-post-id="<%= post.id %>"
            >


                <p>

                    <a
                        href="/perfil/<%= post.autor.slug %>"
                    >

                        <strong>
                            <%= post.autor.nomeCompleto %>
                        </strong>

                    </a>


                    <% if (post.autor.colaborador) { %>

                        —
                        Colaborador
                        <%= post.autor.nivel %>

                    <% } %>

                </p>


                <p>

                    <small>
                        <%= post.categoria %>
                    </small>

                </p>


                <h2 class="post-titulo">
                    <%= post.titulo %>
                </h2>


                <p class="post-conteudo">
                    <%= post.conteudo %>
                </p>


                <% if (
                    usuarioAtual
                    &&
                    usuarioAtual.id
                    === post.usuarioId
                ) { %>


                    <div class="temp-actions">


                        <button
                            type="button"
                            class="editar-post"
                            data-id="<%= post.id %>"
                            data-titulo="<%= post.titulo %>"
                            data-conteudo="<%= post.conteudo %>"
                        >
                            Editar
                        </button>


                        <button
                            type="button"
                            class="excluir-post"
                            data-id="<%= post.id %>"
                        >
                            Excluir
                        </button>


                    </div>


                <% } %>


                <h3>
                    Comentários
                    (<%= post.comentarios.length %>)
                </h3>


                <% post.comentarios.forEach(
                    (comentario) => {
                %>


                    <div class="temp-comment">


                        <p>

                            <a
                                href="/perfil/<%= comentario.autor.slug %>"
                            >

                                <strong>
                                    <%= comentario.autor.nomeCompleto %>
                                </strong>

                            </a>

                        </p>


                        <p class="comentario-texto">
                            <%= comentario.texto %>
                        </p>


                        <% if (
                            usuarioAtual
                            &&
                            usuarioAtual.id
                            === comentario.usuarioId
                        ) { %>


                            <div class="temp-actions">


                                <button
                                    type="button"
                                    class="editar-comentario"
                                    data-id="<%= comentario.id %>"
                                    data-texto="<%= comentario.texto %>"
                                >
                                    Editar comentário
                                </button>


                                <button
                                    type="button"
                                    class="excluir-comentario"
                                    data-id="<%= comentario.id %>"
                                >
                                    Excluir comentário
                                </button>


                            </div>


                        <% } %>


                    </div>


                <% }) %>


                <% if (usuarioAtual) { %>


                    <form
                        class="form-comentario"
                        data-post-id="<%= post.id %>"
                    >


                        <label>
                            Comentar
                        </label>


                        <textarea
                            name="texto"
                            maxlength="1000"
                            required
                        ></textarea>


                        <button type="submit">
                            Enviar comentário
                        </button>


                    </form>


                <% } %>


            </article>


        <% }) %>


    </section>


</main>


<script src="/comunidade-temp.js"></script>


</body>

</html>