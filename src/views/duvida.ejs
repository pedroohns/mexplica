<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        MEXPLICA - <%= duvida.titulo %>
    </title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

    <link
        rel="shortcut icon"
        href="/icons/favicon.ico"
        type="image/x-icon"
    >

</head>


<body>
    <script>
    (function() {
        var salvo = localStorage.getItem('mexplica-tema');

        if (salvo === '1') {
            document.body.classList.add('dark-blue');
        }
    })();
</script>


<header class="header">

    <nav class="nav container">

        <a href="/" class="nav-logo">

            <img
                src="/icons/logo-mexplica.png"
                alt="MEXPLICA"
                class="logo-icon"
            >

        </a>


        <ul class="nav-links">

            <li>
                <a href="/cadastro.html">
                    Colabore
                </a>
            </li>

            <li>
                <a href="/comunidade">
                    Comunidade
                </a>
            </li>

            <li>
                <a href="#">
                    Ajuda
                </a>
            </li>

            <li>
                <a href="#">
                    Sobre
                </a>
            </li>

        </ul>


        <div class="nav-actions">

            <% if (usuarioAtual) { %>

                <a
                    href="/perfil/<%= usuarioAtual.slug %>"
                    class="btn-acessar"
                >

                    <%= usuarioAtual.nome %>

                </a>

            <% } else { %>

                <a
                    href="/cadastro.html"
                    class="btn-acessar"
                >

                    acessar conta

                </a>

            <% } %>

        </div>


        <button
            class="nav-toggle"
            aria-label="Abrir menu"
            id="navToggle"
        >

            <span></span>
            <span></span>
            <span></span>

        </button>

    </nav>

</header>


<main class="mexp-page">


    <section
        class="container mexp-question-detail"
        data-duvida-id="<%= duvida.id %>"
    >


        <a
            href="/"
            class="mexp-back-link"
        >

            ← Voltar para a pesquisa

        </a>


        <div class="mexp-question-detail-head">

            <span class="mexp-category">

                <%= duvida.categoria %>

            </span>


            <h1 id="duvidaTitulo">

                <%= duvida.titulo %>

            </h1>


            <div class="mexp-question-meta">

                <span>

                    Perguntado por

                    <a
                        href="/perfil/<%= duvida.autor.slug %>"
                    >

                        <%= duvida.autor.nomeCompleto %>

                    </a>

                </span>

                <span>

                    <%= duvida.visualizacoes %>
                    visualizações

                </span>

                <span>

                    <%= respostas.length %>
                    respostas

                </span>

            </div>

        </div>


        <p
            id="duvidaConteudo"
            class="mexp-question-body"
        >

            <%= duvida.conteudo %>

        </p>


        <%
            if (
                usuarioAtual
                &&
                usuarioAtual.id
                === duvida.usuarioId
            ) {
        %>


            <div class="mexp-inline-actions">


                <button
                    type="button"
                    class="mexp-secondary-button"
                    id="editarDuvida"
                    data-id="<%= duvida.id %>"
                    data-categoria="<%= duvida.categoria %>"
                >
                    Editar dúvida
                </button>


                <button
                    type="button"
                    class="mexp-danger-button"
                    id="excluirDuvida"
                    data-id="<%= duvida.id %>"
                >
                    Excluir dúvida
                </button>


            </div>


        <% } %>


    </section>


    <section class="container mexp-section">


        <div class="mexp-section-heading">

            <div>

                <span class="mexp-eyebrow">
                    RESPOSTAS
                </span>

                <h2>

                    <%= respostas.length %>

                    resposta<%= respostas.length === 1 ? '' : 's' %>

                </h2>

            </div>

        </div>


        <div class="mexp-answer-list">


            <% if (!respostas.length) { %>

                <div class="mexp-empty">

                    Esta dúvida ainda não recebeu respostas.
                    Os colaboradores poderão respondê-la
                    em breve.

                </div>

            <% } %>


            <%
                respostas.forEach(
                    resposta => {
            %>


                <article
                    class="mexp-answer-card"
                    data-resposta-id="<%= resposta.id %>"
                >


                    <div class="mexp-answer-author">


                        <div class="mexp-avatar">

                            <%= resposta.autor.nome.charAt(0) %>

                        </div>


                        <div>

                            <a
                                href="/perfil/<%= resposta.autor.slug %>"
                            >

                                <strong>
                                    <%= resposta.autor.nomeCompleto %>
                                </strong>

                            </a>

                            <span>

                                Colaborador
                                <%= resposta.autor.nivel %>
                                ·
                                <%= resposta.autor.pontos %>
                                pontos

                            </span>

                        </div>

                    </div>


                    <p class="mexp-answer-text">

                        <%= resposta.texto %>

                    </p>


                    <%
                        if (
                            resposta.midias
                            &&
                            resposta.midias.length
                        ) {
                    %>

                        <div class="mexp-media-list">

                            <%
                                resposta.midias.forEach(
                                    midia => {
                            %>

                                <% if (midia.tipo === 'imagem') { %>

                                    <a
                                        href="<%= midia.url %>"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="mexp-media-link"
                                    >
                                        Ver imagem de apoio
                                    </a>

                                <% } else { %>

                                    <a
                                        href="<%= midia.url %>"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="mexp-media-link"
                                    >
                                        Ver vídeo de apoio
                                    </a>

                                <% } %>

                            <% }) %>

                        </div>

                    <% } %>


                    <div class="mexp-rating-summary">

                        <strong>

                            <%= resposta.avaliacao.quantidade

                                ? `${resposta.avaliacao.media} ★`

                                : 'Sem avaliações'

                            %>

                        </strong>


                        <% if (resposta.avaliacao.quantidade) { %>

                            <span>

                                <%= resposta.avaliacao.quantidade %>

                                avaliação<%= resposta.avaliacao.quantidade === 1 ? '' : 'ões' %>

                            </span>

                        <% } %>

                    </div>


                    <%
                        if (
                            usuarioAtual
                            &&
                            usuarioAtual.id
                            !== resposta.usuarioId
                        ) {
                    %>


                        <div
                            class="mexp-rating-box"
                            data-resposta-id="<%= resposta.id %>"
                            data-avaliacao-id="<%= resposta.minhaAvaliacao ? resposta.minhaAvaliacao.id : '' %>"
                            data-nota-atual="<%= resposta.minhaAvaliacao ? resposta.minhaAvaliacao.nota : '' %>"
                        >

                            <span>
                                Esta resposta ajudou você?
                            </span>


                            <div
                                class="mexp-stars"
                                aria-label="Avaliar resposta de 1 a 5 estrelas"
                            >

                                <%
                                    for (
                                        let nota = 1;
                                        nota <= 5;
                                        nota += 1
                                    ) {
                                %>

                                    <button
                                        type="button"
                                        class="mexp-star <%= resposta.minhaAvaliacao && nota <= resposta.minhaAvaliacao.nota ? 'is-active' : '' %>"
                                        data-nota="<%= nota %>"
                                        aria-label="<%= nota %> estrela<%= nota === 1 ? '' : 's' %>"
                                    >
                                        ★
                                    </button>

                                <% } %>

                            </div>


                            <% if (resposta.minhaAvaliacao) { %>

                                <button
                                    type="button"
                                    class="mexp-text-button remover-avaliacao"
                                >

                                    Remover minha avaliação

                                </button>

                            <% } %>

                        </div>


                    <% } else if (!usuarioAtual) { %>


                        <p class="mexp-login-hint">

                            <a
                                href="/cadastro.html?redirect=<%= encodeURIComponent(`/duvidas/${duvida.slug}`) %>"
                            >
                                Entre na sua conta
                            </a>

                            para avaliar esta resposta.

                        </p>


                    <% } %>


                    <%
                        if (
                            usuarioAtual
                            &&
                            usuarioAtual.id
                            === resposta.usuarioId
                        ) {
                    %>


                        <div class="mexp-inline-actions">


                            <button
                                type="button"
                                class="mexp-secondary-button editar-resposta"
                                data-id="<%= resposta.id %>"
                            >
                                Editar resposta
                            </button>


                            <button
                                type="button"
                                class="mexp-danger-button excluir-resposta"
                                data-id="<%= resposta.id %>"
                            >
                                Excluir resposta
                            </button>


                        </div>


                    <% } %>


                </article>


            <% }) %>


        </div>

    </section>


    <section class="container mexp-section">


        <% if (usuarioAtual && usuarioAtual.colaborador) { %>


            <div class="mexp-section-heading">

                <div>

                    <span class="mexp-eyebrow">
                        COLABORADOR
                    </span>

                    <h2>
                        Responder esta dúvida
                    </h2>

                </div>

                <p>
                    Sua resposta poderá receber avaliações
                    e contribuir para sua pontuação.
                </p>

            </div>


            <form
                id="formResposta"
                class="mexp-form"
                data-duvida-id="<%= duvida.id %>"
            >


                <label for="respostaTexto">
                    Resposta
                </label>


                <textarea
                    id="respostaTexto"
                    name="texto"
                    maxlength="4000"
                    required
                    placeholder="Explique a solução de forma simples e objetiva."
                ></textarea>


                <div class="mexp-form-row">


                    <div>

                        <label for="midiaTipo">
                            Mídia de apoio
                            (opcional)
                        </label>

                        <select
                            id="midiaTipo"
                            name="midiaTipo"
                        >

                            <option value="">
                                Sem mídia
                            </option>

                            <option value="imagem">
                                Imagem
                            </option>

                            <option value="video">
                                Vídeo
                            </option>

                        </select>

                    </div>


                    <div>

                        <label for="midiaUrl">
                            URL da mídia
                        </label>

                        <input
                            id="midiaUrl"
                            name="midiaUrl"
                            type="url"
                            placeholder="https://..."
                        >

                    </div>


                </div>


                <p
                    id="respostaMensagem"
                    class="mexp-form-message"
                    aria-live="polite"
                ></p>


                <button
                    type="submit"
                    class="mexp-primary-button"
                >
                    Enviar resposta
                </button>


            </form>


        <% } else if (usuarioAtual) { %>


            <div class="mexp-callout">

                <div>

                    <strong>
                        Somente colaboradores
                        podem responder dúvidas.
                    </strong>

                    <p>
                        Como usuário, você pode
                        fazer perguntas e avaliar
                        as respostas recebidas.
                    </p>

                </div>

            </div>


        <% } else { %>


            <div class="mexp-callout">

                <div>

                    <strong>
                        Quer participar da plataforma?
                    </strong>

                    <p>
                        Entre na sua conta para fazer
                        perguntas ou avaliar as respostas
                        dos colaboradores.
                    </p>

                </div>


                <a
                    href="/cadastro.html?redirect=<%= encodeURIComponent(`/duvidas/${duvida.slug}`) %>"
                    class="mexp-primary-link"
                >
                    Acessar conta
                </a>

            </div>


        <% } %>


    </section>


</main>


<script src="/script.js"></script>

<script src="/duvida.js"></script>


</body>

</html>