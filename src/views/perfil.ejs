<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        MExplica - <%= perfil.nomeCompleto %>
    </title>

    <link
        rel="stylesheet"
        href="/style.css"
    >


    <style>

        .temp-page {
            max-width: 760px;
            margin: 40px auto;
            padding: 24px;
            font-family: Arial, sans-serif;
        }

        .temp-card {
            border: 1px solid #ddd;
            border-radius: 16px;
            padding: 20px;
            margin: 18px 0;
            background: #fff;
        }

        textarea {
            width: 100%;
            min-height: 100px;
            box-sizing: border-box;
            padding: 10px;
        }

        button {
            padding: 9px 14px;
            cursor: pointer;
            margin-top: 8px;
        }

    </style>

</head>


<body>

<main class="temp-page">


    <p>

        <a href="/comunidade">
            ← Comunidade
        </a>

    </p>


    <section class="temp-card">


        <h1>
            <%= perfil.nomeCompleto %>
        </h1>


        <p>

            <strong>
                Tipo:
            </strong>

            <%= perfil.colaborador
                ? `Colaborador ${perfil.nivel}`
                : 'Usuário'
            %>

        </p>


        <p>

            <strong>
                Pontos:
            </strong>

            <%= perfil.pontos %>

        </p>


        <p>

            <strong>
                Bio:
            </strong>

            <span id="bio-atual">

                <%= perfil.bio
                    || 'Sem biografia.'
                %>

            </span>

        </p>


        <% if (
            usuarioAtual
            &&
            usuarioAtual.id
            === perfil.id
        ) { %>


            <hr>


            <h2>
                Editar meu perfil
            </h2>


            <form
                id="form-editar-perfil"
                data-id="<%= perfil.id %>"
            >


                <label for="bio">
                    Biografia
                </label>


                <textarea
                    id="bio"
                    name="bio"
                    maxlength="500"
                ><%= perfil.bio %></textarea>


                <button type="submit">
                    Salvar alterações
                </button>


            </form>


            <button
                id="excluir-conta"
                type="button"
                data-id="<%= perfil.id %>"
            >
                Excluir minha conta
            </button>


        <% } %>


    </section>


    <section class="temp-card">


        <h2>
            Publicações
        </h2>


        <% if (
            posts.length === 0
        ) { %>


            <p>
                Este usuário ainda
                não publicou nada.
            </p>


        <% } %>


        <% posts.forEach(
            post => {
        %>


            <article>

                <h3>
                    <%= post.titulo %>
                </h3>

                <p>
                    <%= post.conteudo %>
                </p>

                <hr>

            </article>


        <% }) %>


    </section>


</main>


<script src="/perfil-temp.js"></script>


</body>

</html>